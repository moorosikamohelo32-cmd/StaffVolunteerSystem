@model Responsibility
@{ ViewData["Title"] = "Assign"; }

<h1>Assign: @Model.Title</h1>

<form asp-action="Assign" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label class="form-label">Person</label>
        <select name="personId" asp-items="(List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.People" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-primary">Assign</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>